<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Move-in Planner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,650&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header">
    <nav class="container nav-shell">
        <a asp-controller="Dashboard" asp-action="Index" class="brand"><span class="brand-mark">M</span><span>Move-in Planner</span></a>
        <div class="nav-links">
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-controller="Items" asp-action="Index">All items</a>
        </div>
        <a asp-controller="Items" asp-action="Create" class="btn btn-primary btn-sm">+ Add item</a>
    </nav>
</header>
<main class="container app-main">
    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@message<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>
<footer class="container app-footer">Move-in Planner · ASP.NET Core MVC + EF Core</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
